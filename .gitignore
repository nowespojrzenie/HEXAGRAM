# package-lock.json JEST w repo od 21.09.2026 (D3, słowo twórcy "L1"): lockfile to nie są
# zależności, tylko 10 KB zapisu, KTÓRE wersje zainstalowano. Bez niego ^zakresy dawały różne
# wersje silnika na różnych maszynach (zmierzone: @swisseph/node ^1.2.2 -> 1.3.1).
.markery_osobowe
# odcisk kompletności listy markerów (M2, #115, 22.09.2026): liczba wzorców + sha256[:12] listy
# w chwili ostatniego jawnego zapisu. Poza kanonem jak sama lista — dana per-instancja, nie treść.
# Zapisywany WYŁĄCZNIE: bash publikuj.sh --zapisz-odcisk-markerow. Nigdy treści wzorców.
.markery_osobowe.odcisk
# baseline baterii (02.09.2026, decyzja twórcy): liczba oblanych torów TEGO środowiska.
# Poza kanonem świadomie — Windows i Linux mają różne baseline'y, więc plik w repo byłby
# cudzą prawdą o cudzej maszynie. Zapisywany WYŁĄCZNIE: bash zapis_git.sh --baseline-baterii
.baseline_baterii
# zamek biegu mutacje.sh (#112, 22.09.2026): PID:czas_start ostatniego biegu, kasowany w trap
# EXIT. Ślad procesu na TEJ maszynie w TEJ chwili — nie kanon, nigdy nie powinien przetrwać
# do commita (a jeśli przetrwa po awarii, następny bieg go sprząta/nadpisuje sam).
.mutacje_lock
# ślad pominiętych mutacje.sh (#116, 22.09.2026): zbiór NAZW pominiętych z OSTATNIEGO biegu
# NA TEJ MASZYNIE — jak .baseline_baterii, dwie maszyny mogą legalnie mieć różne zbiory
# (gałąź odlewu vs pracy, obecność plików). Poza kanonem, per-instancja, nadpisywany co bieg.
kanon/pomiary/MUTACJE_pominiete.txt
